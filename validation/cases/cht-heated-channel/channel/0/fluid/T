FoamFile { version 2.0; format ascii; class volScalarField; object T; }

dimensions      [0 0 0 1 0 0 0];
internalField   uniform 300;
boundaryField
{
    inlet { type fixedValue; value uniform 300; }
    outlet { type zeroGradient; }
    symmetry { type symmetryPlane; }
    // The same temperature and the same heat flux on the 2 sides of the interface.
    "interface.*"
    {
        type            compressible::turbulentTemperatureRadCoupledMixed;
        Tnbr            T;
        kappaMethod     fluidThermo;
        value           $internalField;
    }
    frontAndBack { type empty; }
}
