# Patch test. Class N: the field is linear, so the exact result has no discretisation error.
id = patch-test
class = N
justification = The imposed displacement field is linear, so C3D8 must reproduce it and its uniform stress to round-off. No mesh error exists, so Richardson does not apply. The tolerance covers round-off in a sparse solve only.
derivation = derivation.md
mesh = ../../../fixtures/inp/patch-test.inp
rel_tol = 1e-8
abs_tol = 1e-12
# Displacement of interior node 9 at (0.25, 0.25, 0.25), in mm.
ref = u9_x 0.000325
ref = u9_y 0.000225
ref = u9_z 0.000175
# Stress in every element, in MPa.
ref = s_xx 327.6
ref = s_yy 243.6
ref = s_zz 226.8
ref = s_xy 42.0
ref = s_yz 16.8
ref = s_zx 25.2
