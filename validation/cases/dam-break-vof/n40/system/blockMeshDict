FoamFile { version 2.0; format ascii; class dictionary; object blockMeshDict; }

// The tank: 5a long and 2.5a high, 1 cell thick in z. a = 2.25 in is the width of the column.
// n is the number of cells across a. The cells are squares.
a       0.05715;
n       40;
L       #eval{ 5*$a };
H       #eval{ 2.5*$a };
nx      #eval{ 5*$n };
ny      #eval{ 2.5*$n };
dz      #eval{ $a/$n };
vertices
(
    (0 0 0) ($L 0 0) ($L $H 0) (0 $H 0)
    (0 0 $dz) ($L 0 $dz) ($L $H $dz) (0 $H $dz)
);
blocks (hex (0 1 2 3 4 5 6 7) ($nx $ny 1) simpleGrading (1 1 1));
boundary
(
    walls { type wall; faces ((0 4 7 3) (1 2 6 5) (0 1 5 4)); }
    atmosphere { type patch; faces ((3 7 6 2)); }
    frontAndBack { type empty; faces ((0 3 2 1) (4 5 6 7)); }
);
