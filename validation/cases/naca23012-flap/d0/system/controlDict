FoamFile { version 2.0; format ascii; class dictionary; object controlDict; }

application     simpleFoam;
startFrom       startTime;
startTime       0;
stopAt          endTime;
endTime         1000;
deltaT          1;
writeControl    timeStep;
writeInterval   1000;
writeFormat     ascii;
writePrecision  10;
timePrecision   6;
runTimeModifiable false;

functions
{
    forceCoeffs
    {
        type            forceCoeffs;
        libs            (forces);
        writeControl    timeStep;
        writeInterval   1;
        patches         (wall);
        rho             rhoInf;
        rhoInf          1;
        magUInf         1;
        lRef            1;
        Aref            1;
        liftDir         (-0 1 0);
        dragDir         (1 0 0);
        CofR            (0.238 0.07 0);
    }
}
